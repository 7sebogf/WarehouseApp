<Window x:Class="WarehouseApp.Views.AIHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤖 AI Помощник склада"
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="MessageUser" TargetType="Border">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="CornerRadius" Value="15,15,5,15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="50,5,10,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="MessageAI" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15,15,15,5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="10,5,50,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4361EE" Padding="15">
            <StackPanel>
                <TextBlock Text="🤖 AI ПОМОЩНИК СКЛАДА" FontSize="18" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                <TextBlock x:Name="txtStatus" Text="🟢 Готов к работе" FontSize="11" Foreground="#E0E0E0" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="10" Margin="10,10,10,0" CornerRadius="10">
            <WrapPanel>
                <Button x:Name="btnAnalyzeStock" Content="📊 Анализ склада" Click="AnalyzeStock_Click" 
                        Background="#E3F2FD" Foreground="#1565C0" Padding="10,5" Margin="2" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnRecommendReplenishment" Content="🛒 Рекомендация пополнения" Click="RecommendReplenishment_Click" 
                        Background="#FFF3E0" Foreground="#E65100" Padding="10,5" Margin="2" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnFindAlternatives" Content="🔍 Поиск аналогов" Click="FindAlternatives_Click" 
                        Background="#E8F5E9" Foreground="#2E7D32" Padding="10,5" Margin="2" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnForecastSales" Content="📈 Прогноз продаж" Click="ForecastSales_Click" 
                        Background="#F3E5F5" Foreground="#7B1FA2" Padding="10,5" Margin="2" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="btnGenerateDescription" Content="🏷️ Описание товара" Click="GenerateDescription_Click" 
                        Background="#FFEBEE" Foreground="#C62828" Padding="10,5" Margin="2" BorderThickness="0" Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="ChatScroll" Grid.Row="2" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatPanel"/>
        </ScrollViewer>

        <Border Grid.Row="3" Background="White" Padding="10" Margin="10" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtInput" Grid.Column="0" Height="40" Padding="10,8" 
                         FontSize="13" BorderBrush="#DEE2E6" BorderThickness="1"
                         KeyDown="txtInput_KeyDown"/>

                <Button x:Name="btnSend" Grid.Column="1" Content="📤 Отправить" 
                        Width="80" Height="40" Margin="10,0,0,0"
                        Background="#4361EE" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="Send_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>