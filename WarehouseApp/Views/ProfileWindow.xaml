<Window x:Class="WarehouseApp.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👤 Личный кабинет"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#4361EE" Padding="20" Margin="-20,0,-20,20">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Background="White" Width="60" Height="60" CornerRadius="30">
                        <TextBlock x:Name="txtAvatar" Text="👤" FontSize="32" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtWelcomeName" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="txtWelcomeRole" FontSize="13" Foreground="#E0E0E0"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="White" Padding="15,8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⭐ " FontSize="16"/>
                        <TextBlock x:Name="txtWelcomePoints" FontSize="16" FontWeight="Bold" Foreground="#4361EE"/>
                        <TextBlock Text=" баллов" FontSize="14" Foreground="#6C757D" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Вкладки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="btnProfileTab" Content="Профиль" Padding="20,10" Background="Transparent" 
                    BorderThickness="0,0,0,2" BorderBrush="#4361EE" Foreground="#4361EE" 
                    FontWeight="Bold" Click="ProfileTab_Click"/>
            <Button x:Name="btnOrdersTab" Content="История заказов" Padding="20,10" Background="Transparent" 
                    BorderThickness="0" Foreground="Gray" Click="OrdersTab_Click"/>
            <Button x:Name="btnAwardsTab" Content="Награды" Padding="20,10" Background="Transparent" 
                    BorderThickness="0" Foreground="Gray" Click="AwardsTab_Click"/>
        </StackPanel>

        <!-- Профиль -->
        <ScrollViewer x:Name="profilePanel" Grid.Row="2" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8F9FA" Padding="15" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ" FontWeight="Bold" Foreground="#4361EE" Margin="0,0,0,15"/>
                        <TextBlock Text="ФИО" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtFullName" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Логин" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtLogin" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Роль" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtRole" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Email" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtEmail" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Телефон" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtPhone" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Дата регистрации" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtRegDate" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F8F9FA" Padding="15" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" FontWeight="Bold" Foreground="#4361EE" Margin="0,0,0,15"/>

                        <TextBlock Text="Пол" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtGender" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Дата рождения" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtBirthDate" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Город" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtCity" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Адрес" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="txtAddress" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Separator Margin="0,10,0,10"/>

                        <TextBlock Text="НЕЙРОСЕТЬ" FontWeight="Bold" Foreground="#4361EE" Margin="0,0,0,10"/>
                        <TextBlock x:Name="txtAISubscription" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="btnSubscribe" Content="Подключить за 100 баллов" 
                                Background="#28A745" Foreground="White" Padding="12,8" 
                                BorderThickness="0" Cursor="Hand" Width="180"
                                HorizontalAlignment="Left" Click="Subscribe_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- История заказов -->
        <Grid x:Name="ordersPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#F8F9FA" Padding="10" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Всего заказов: " FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="txtOrdersCount" FontSize="12" FontWeight="Bold" Foreground="#4361EE" Text="0"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="dgOrders" Grid.Row="1" AutoGenerateColumns="False" Height="200" Margin="0,0,0,15"
                      SelectionChanged="DgOrders_SelectionChanged" BorderBrush="#E9ECEF" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderNumber}" Width="*"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:C}}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Background="#F8F9FA" Padding="15">
                <StackPanel>
                    <TextBlock Text="ДЕТАЛИ ЗАКАЗА" FontWeight="Bold" Foreground="#4361EE" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtOrderDetails" Text="Выберите заказ для просмотра" Foreground="Gray" TextWrapping="Wrap"/>
                    <Button Content="Показать чек" Background="#4361EE" Foreground="White" Padding="12,8" 
                            BorderThickness="0" Cursor="Hand" Width="120" HorizontalAlignment="Right" 
                            Margin="0,15,0,0" Click="ShowReceipt_Click" x:Name="btnShowReceipt" IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Награды -->
        <ScrollViewer x:Name="awardsPanel" Grid.Row="2" Visibility="Collapsed">
            <Border Background="#F8F9FA" Padding="20">
                <StackPanel>
                    <TextBlock Text="ДОСТИЖЕНИЯ" FontSize="16" FontWeight="Bold" Foreground="#4361EE" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtAwardsInfo" TextWrapping="Wrap" LineHeight="25"/>

                    <Separator Margin="0,20,0,20"/>

                    <TextBlock Text="КАК ПОЛУЧИТЬ БАЛЛЫ" FontSize="14" FontWeight="Bold" Foreground="#4361EE" Margin="0,0,0,10"/>
                    <Border Background="#E8F5E9" Padding="12">
                        <StackPanel>
                            <TextBlock Text="➕ Добавление товара +5 баллов" Margin="0,2"/>
                            <TextBlock Text="✏️ Редактирование товара +3 балла" Margin="0,2"/>
                            <TextBlock Text="🗑️ Удаление товара +2 балла" Margin="0,2"/>
                            <TextBlock Text="🔍 Поиск по сертификату +2 балла" Margin="0,2"/>
                            <TextBlock Text="📊 Экспорт данных +5 баллов" Margin="0,2"/>
                            <TextBlock Text="📋 Формирование плана +5 баллов" Margin="0,2"/>
                            <TextBlock Text="🛒 Оформление заказа +10 баллов" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>