<Window x:Class="WarehouseApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Складская система"
        Height="680" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        MinHeight="680" MinWidth="550"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Border Background="White" Margin="15" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🏢 Управление складом" 
                           FontSize="22" FontWeight="Bold" Foreground="#4361EE"
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Button x:Name="btnLoginTab" Content="Вход" Width="120" Height="35"
                            Background="#4361EE" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="LoginTab_Click"/>
                    <Button x:Name="btnRegisterTab" Content="Регистрация" Width="120" Height="35"
                            Background="#E9ECEF" Foreground="#6C757D" BorderThickness="0"
                            Cursor="Hand" Click="RegisterTab_Click" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Панель входа -->
                <StackPanel x:Name="loginPanel" Grid.Row="2" Visibility="Visible">
                    <TextBlock Text="Логин" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Пароль" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"/>

                    <Button Content="Войти" Style="{StaticResource ModernButton}" Click="Login_Click" Margin="0,15,0,10"/>

                    <TextBlock x:Name="txtLoginError" Text="" Foreground="#DC3545" FontSize="12"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Панель регистрации -->
                <ScrollViewer x:Name="registerPanel" Grid.Row="2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" MaxHeight="460">
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Логин*" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRegLogin" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Пароль*" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="txtRegPassword" Style="{StaticResource ModernPasswordBox}"/>

                        <TextBlock Text="Подтверждение пароля*" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource ModernPasswordBox}"/>

                        <TextBlock Text="ФИО*" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtFullName" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Телефон" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtPhone" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Пол" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <ComboBox x:Name="cmbGender" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Не выбран" IsSelected="True"/>
                            <ComboBoxItem Content="Мужской"/>
                            <ComboBoxItem Content="Женский"/>
                        </ComboBox>

                        <TextBlock Text="Дата рождения" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <DatePicker x:Name="dpBirthDate" Style="{StaticResource ModernDatePicker}"/>

                        <TextBlock Text="Город" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtCity" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Адрес" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtAddress" Style="{StaticResource ModernTextBox}" Height="50" TextWrapping="Wrap"/>

                        <TextBlock Text="* - обязательные поля" FontSize="10" Foreground="#6C757D" Margin="0,5,0,5"/>

                        <Button Content="Зарегистрироваться" Style="{StaticResource ModernButton}" 
                                Click="Register_Click" Margin="0,10,0,5"/>

                        <TextBlock x:Name="txtRegisterError" Text="" Foreground="#DC3545" FontSize="12"
                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Информация -->
                <Border Grid.Row="3" Background="#FFF3E0" Padding="10" Margin="0,15,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#E65100">
                        <Run Text="📌 Тестовые учетные записи:" FontWeight="Bold"/><LineBreak/>
                        <Run Text="admin / admin123 (Администратор)"/><LineBreak/>
                        <Run Text="manager / manager123 (Менеджер)"/><LineBreak/>
                        <Run Text="user / user123 (Пользователь)"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>