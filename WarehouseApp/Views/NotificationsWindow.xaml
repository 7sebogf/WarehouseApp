<Window x:Class="WarehouseApp.Views.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔔 Уведомления"
        Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#4361EE" Padding="15">
            <TextBlock Text="🔔 Уведомления" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <ListBox x:Name="lstNotifications" Grid.Row="1" Margin="10" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#F8F9FA" Margin="5" Padding="10" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#4361EE"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5,0,5"/>
                            <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>