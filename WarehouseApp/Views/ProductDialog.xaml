<Window x:Class="WarehouseApp.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="550" Width="500"
        MinHeight="550" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="txtTitle" Text="➕ Добавление товара" FontSize="20" FontWeight="Bold" 
                   Foreground="#4361EE" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Название*" FontSize="13" FontWeight="SemiBold" Margin="0,5"/>
        <TextBox x:Name="txtName" Grid.Row="2" Height="35" Margin="0,0,0,10" Padding="8" BorderBrush="#DEE2E6" BorderThickness="1"/>

        <TextBlock Grid.Row="3" Text="Артикул*" FontSize="13" FontWeight="SemiBold" Margin="0,5"/>
        <TextBox x:Name="txtArticle" Grid.Row="4" Height="35" Margin="0,0,0,10" Padding="8" BorderBrush="#DEE2E6" BorderThickness="1"/>

        <TextBlock Grid.Row="5" Text="Категория" FontSize="13" FontWeight="SemiBold" Margin="0,5"/>
        <ComboBox x:Name="cmbCategory" Grid.Row="6" Height="35" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Text="Статус" FontSize="13" FontWeight="SemiBold" Margin="0,5"/>
        <ComboBox x:Name="cmbStatus" Grid.Row="8" Height="35" Margin="0,0,0,10"/>

        <Grid Grid.Row="9" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="⚖️ Вес (кг)" FontSize="12" Foreground="#6C757D"/>
                <TextBox x:Name="txtWeight" Height="30" Margin="0,2,0,0" Text="0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0">
                <TextBlock Text="📦 Количество" FontSize="12" Foreground="#6C757D"/>
                <TextBox x:Name="txtQuantity" Height="30" Margin="0,2,0,0" Text="0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="💰 Цена" FontSize="12" Foreground="#6C757D"/>
                <TextBox x:Name="txtPrice" Height="30" Margin="0,2,0,0" Text="0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="10" Text="🔐 Сертификат" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,5"/>
        <TextBox x:Name="txtCertificate" Grid.Row="11" Height="35" Margin="0,0,0,15" Padding="8" BorderBrush="#DEE2E6" BorderThickness="1"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="💾 Сохранить" Width="100" Height="35" 
                    Background="#28A745" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Save_Click" Margin="0,0,10,0"/>
            <Button Content="❌ Отмена" Width="100" Height="35" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>